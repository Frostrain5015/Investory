{
  "name": "investory-desktop",
  "version": "6.2.2",
  "description": "Investory Desktop Client",
  "author": "Investory",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ..\\frontend && npx vite build --mode electron --outDir ..\\desktop\\dist --base ./",
    "build:exe": "npm run build:frontend && electron-builder --win",
    "build:msi": "npm run build:frontend && electron-builder --win msi",
    "build": "npm run build:exe"
  },
  "build": {
    "appId": "com.investory.desktop",
    "productName": "Investory",
    "directories": {
      "output": "C:\\tmp\\investory-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Investory",
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Frostrain5015",
      "repo": "Investory",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "electron-updater": "^6.8.3"
  }
}
