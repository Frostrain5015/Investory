# Investory 数据抓取配置文件
# 复制此文件为 config.ini 并填写实际值
# 优先级: 命令行参数 > 环境变量 > config.ini > 默认值

[database]
host     = localhost
port     = 3306
name     = investory
user     = root
password = your_password_here

[proxy]
# 美股 Yahoo Finance 需要代理（大陆服务器）
# 留空则尝试直连（国内机器通常失败）
# 示例: socks5h://127.0.0.1:7890
#       http://127.0.0.1:7890
url =

[search]
# 联网搜索：国内信息走博查 Bocha（无需代理、中文结果好），海外信息走 Tavily（经代理、LLM 原生）
# 博查注册: https://open.bochaai.com   Tavily 注册: https://app.tavily.com （免费 1000 次/月）
# 博查优先，失败时降级到 Tavily。也可用环境变量 BOCHA_API_KEY / TAVILY_API_KEY 覆盖
# （服务器上推荐用 systemd 环境变量注入，不要写进仓库）
bocha_key =
tavily_key =

[fetch]
# 抓取最近 N 个日历日的数据（覆盖周末节假日）
days_back = 7
# 各市场请求间隔（秒），防限速
delay_a  = 0.15
delay_hk = 0.05
delay_us = 0.3
